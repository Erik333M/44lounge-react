# Copy this file to .env.local (for npm run dev) and/or add the same names in Vercel →
# Project → Settings → Environment Variables (for the live site).

# Bookings page password (/admin on the live site). Required on the live site; optional on your computer.
ADMIN_PASSWORD=

# Booking storage. On Vercel: Storage → Create → Upstash (Redis) → connect to this project;
# Vercel fills these two in automatically. On your computer they can stay empty
# (requests are then kept in data/bookings.json).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: also send each new request to Telegram.
# 1) In Telegram, open @BotFather, send /newbot, follow the steps, copy the token it gives you.
# 2) Send any message to your new bot (or add it to your staff group), then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates and copy the "chat":{"id": ...} number.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
